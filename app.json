{
  "expo": {
    "name": "Plakard",
    "slug": "plakard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-fridge-v1.png",
    "scheme": "plakard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kev243.plakard",
      "icon": "./assets/images/icon-fridge-v1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF9EE",
        "foregroundImage": "./assets/images/android-icon-fridge-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9EE",
          "image": "./assets/images/android-icon-fridge-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101411",
            "image": "./assets/images/android-icon-fridge-foreground.png"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "color": "#00975D",
          "defaultChannel": "expiration-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ddf3ced-01a7-455d-b1e0-c52937528b23"
      }
    },
    "owner": "kev243"
  }
}
